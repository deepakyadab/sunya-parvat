# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values. None of these are exposed to the browser.

# Email delivery (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ENQUIRY_TO=sunyaparvat@gmail.com
# Until you verify a domain in Resend, use the Resend test sender below
# (it only delivers to the email address that owns the Resend account).
ENQUIRY_FROM=Sunya Parvat <onboarding@resend.dev>
# Send visitors a short "we received your message" email (needs a verified domain)
ENQUIRY_SEND_ACK=false
SITE_URL=https://sunya-parvat.vercel.app

# Local testing without sending real email: mock | mock-fail (ignored in production)
# EMAIL_PROVIDER=mock
